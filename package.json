{
  "name": "edil3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nuovo sito EDIL3 dei F.lli Jaupi (Broni, PV). Vite + React + TS, Tailwind v4, struttura shadcn.",
  "scripts": {
    "dev": "vite --port 4820",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4820",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "import:content": "node scripts/import-content.mjs",
    "build:logo": "node scripts/build-logo.mjs 700",
    "build:hero": "node scripts/build-hero.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "node-html-parser": "^9.0.7",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
